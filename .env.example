APP_NAME=Market Intelligence
SCRAPE_INTERVAL=10
LOG_LEVEL=INFO
DATA_PATH=data/parquet
LOG_FILE_PATH=logs/app.log

API_HOST=0.0.0.0
API_PORT=8000
API_STATUS=running

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
DASHBOARD_TITLE=Market Intelligence Dashboard
DASHBOARD_STATUS_LABEL=System Status
DASHBOARD_STATUS=Running

SCRAPER_ENGINE=twscrape
SCRAPER_KEYWORDS=#nifty50,#sensex,#intraday,#banknifty
DISCOVERY_LIMIT_PER_KEYWORD=25
TARGET_TWEETS=50
MAX_TWEETS_PER_RUN=60
CRON_SCHEDULE=*/5 * * * *
CRON_LOG_PATH=logs/cron.log
CRON_LOCK_PATH=data/raw/cron.lock
RUN_STARTUP_JITTER_MIN_SECONDS=0
RUN_STARTUP_JITTER_MAX_SECONDS=120
RATE_LIMIT_COOLDOWN_MIN_SECONDS=900
RATE_LIMIT_COOLDOWN_MAX_SECONDS=1800
LOOKBACK_HOURS=24
SEARCH_FETCH_MULTIPLIER=3
SEARCH_RETRY_ATTEMPTS=3
SEARCH_RETRY_BASE_SECONDS=2
SEARCH_RETRY_MAX_SECONDS=20
TWSCRAPE_WAIT_TIMEOUT=30
TWSCRAPE_WAIT_INTERVAL=1
RAW_OUTPUT=data/raw
CHECKPOINT_PATH=data/raw/checkpoint.json
TWSCRAPE_ACCOUNTS_DB=data/twscrape/accounts.db
DEBUG_ARTIFACTS_PATH=data/raw/debug
COLLECTION_TARGET_TWEETS_LAST_24_HOURS=2000
COLLECTION_PROGRESS_RECENT_RUN_HOURS=6
COLLECTION_STATUS_REPORT_PATH=reports/data_collection_status.json
PROCESSING_REPORT_PATH=reports/processing_report.json
ANALYSIS_REPORT_PATH=reports/analysis_summary.json
PERFORMANCE_REPORT_PATH=reports/performance_benchmark.json
REPORT_TOP_LIMIT=10
BENCHMARK_RECORD_COUNTS=100,1000,2000

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=market-intelligence
MONGODB_TWEETS_COLLECTION=tweets
MONGODB_RUNS_COLLECTION=scrape_runs
MONGODB_SIGNALS_COLLECTION=keyword_signals

PARQUET_TWEETS_PATH=data/parquet/tweets
PARQUET_SIGNALS_PATH=data/parquet/signals
KEYWORD_CONCURRENCY=2
FEATURE_VECTOR_SIZE=32
FEATURE_TOP_TERMS=8
PARQUET_CHUNK_SIZE=500
DASHBOARD_SAMPLE_SIZE=200

X_USERNAME=your_x_handle
X_COOKIES=
X_AUTH_TOKEN=your_auth_token
X_CT0=your_ct0_token
X_PASSWORD=
X_EMAIL=
X_EMAIL_PASSWORD=
